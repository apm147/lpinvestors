generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// Everything below this line is generated by `prisma db pull` against
// db/migrations/*.sql -- see db/README.md. Run `npm run db:migrate` (or
// `npx prisma db pull && npx prisma generate` once the migrations are
// already applied) to populate it. Never hand-edit models here; edit the
// migration SQL instead.
