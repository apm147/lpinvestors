generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model commitment {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  funder_org_id String           @db.Uuid
  programme_id  String?          @db.Uuid
  fund_id       String           @db.Uuid
  amount_gbp    Decimal?         @db.Decimal
  commit_date   DateTime?        @db.Date
  source_url    String
  confidence    confidence_level
  created_at    DateTime         @default(now()) @db.Timestamptz(6)
  fund          fund             @relation(fields: [fund_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  org           org              @relation(fields: [funder_org_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  programme     programme?       @relation(fields: [programme_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([fund_id], map: "idx_commitment_fund_id")
  @@index([funder_org_id], map: "idx_commitment_funder_org_id")
  @@index([programme_id], map: "idx_commitment_programme_id")
}

model crowd_in_out {
  org_id           String        @id @db.Uuid
  has_direct_grant Boolean
  has_govt_equity  Boolean
  channel          crowd_channel
  computed_at      DateTime      @default(now()) @db.Timestamptz(6)
  org              org           @relation(fields: [org_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model fund {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  canonical_name String
  crn            String?       @unique @db.VarChar(10)
  gp_org_id      String?       @db.Uuid
  created_at     DateTime      @default(now()) @db.Timestamptz(6)
  commitment     commitment[]
  org            org?          @relation(fields: [gp_org_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  investment     investment[]
  org_alias      org_alias[]
  person_role    person_role[]

  @@index([crn], map: "idx_fund_crn")
  @@index([gp_org_id], map: "idx_fund_gp_org_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model investment {
  id                                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  investor_org_id                      String?   @db.Uuid
  investor_fund_id                     String?   @db.Uuid
  portfolio_org_id                     String    @db.Uuid
  round_date                           DateTime? @db.Date
  source_filing                        String?
  created_at                           DateTime  @default(now()) @db.Timestamptz(6)
  fund                                 fund?     @relation(fields: [investor_fund_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  org_investment_investor_org_idToorg  org?      @relation("investment_investor_org_idToorg", fields: [investor_org_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  org_investment_portfolio_org_idToorg org       @relation("investment_portfolio_org_idToorg", fields: [portfolio_org_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([investor_fund_id], map: "idx_investment_investor_fund_id")
  @@index([investor_org_id], map: "idx_investment_investor_org_id")
  @@index([portfolio_org_id], map: "idx_investment_portfolio_org_id")
}

model org {
  id                                          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  canonical_name                              String
  crn                                         String?       @unique @db.VarChar(10)
  org_kind                                    org_kind
  is_quilt_tagged                             Boolean       @default(false)
  created_at                                  DateTime      @default(now()) @db.Timestamptz(6)
  updated_at                                  DateTime      @default(now()) @db.Timestamptz(6)
  commitment                                  commitment[]
  crowd_in_out                                crowd_in_out?
  fund                                        fund[]
  investment_investment_investor_org_idToorg  investment[]  @relation("investment_investor_org_idToorg")
  investment_investment_portfolio_org_idToorg investment[]  @relation("investment_portfolio_org_idToorg")
  org_alias                                   org_alias[]
  person_role                                 person_role[]
  programme                                   programme[]
  psc_control                                 psc_control[]

  @@index([crn], map: "idx_org_crn")
  @@index([is_quilt_tagged], map: "idx_org_quilt_tagged", where: raw("is_quilt_tagged"))
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model org_alias {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  raw_name    String
  org_id      String?           @db.Uuid
  fund_id     String?           @db.Uuid
  source      String?
  resolved_by resolution_method
  resolved_at DateTime          @default(now()) @db.Timestamptz(6)
  fund        fund?             @relation(fields: [fund_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  org         org?              @relation(fields: [org_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([fund_id], map: "idx_org_alias_fund_id")
  @@index([org_id], map: "idx_org_alias_org_id")
  @@index([raw_name], map: "idx_org_alias_raw_name")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model person {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  full_name   String
  dob_month   Int?          @db.SmallInt
  dob_year    Int?          @db.SmallInt
  nationality String?
  created_at  DateTime      @default(now()) @db.Timestamptz(6)
  person_role person_role[]
  psc_control psc_control[]

  @@unique([full_name, dob_month, dob_year, nationality])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model person_role {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  person_id String  @db.Uuid
  fund_id   String? @db.Uuid
  org_id    String? @db.Uuid
  role      String
  fund      fund?   @relation(fields: [fund_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  org       org?    @relation(fields: [org_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  person    person  @relation(fields: [person_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([fund_id], map: "idx_person_role_fund_id")
  @@index([org_id], map: "idx_person_role_org_id")
  @@index([person_id], map: "idx_person_role_person_id")
}

model programme {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String            @unique
  parent_org_id  String?           @db.Uuid
  disclosure_url String?
  confidence     confidence_level?
  notes          String?
  created_at     DateTime          @default(now()) @db.Timestamptz(6)
  commitment     commitment[]
  org            org?              @relation(fields: [parent_org_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([parent_org_id], map: "idx_programme_parent_org_id")
}

model psc_control {
  person_id      String    @db.Uuid
  org_id         String    @db.Uuid
  control_nature String
  notified_date  DateTime? @db.Date
  org            org       @relation(fields: [org_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  person         person    @relation(fields: [person_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([person_id, org_id, control_nature])
  @@index([org_id], map: "idx_psc_control_org_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model resolution_queue {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  raw_name          String
  source            String?
  candidate_org_ids String[]  @db.Uuid
  status            String    @default("open")
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  reviewed_at       DateTime? @db.Timestamptz(6)

  @@index([status], map: "idx_resolution_queue_status", where: raw("(status = 'open'::text)"))
}

enum confidence_level {
  high
  medium
  low
}

enum crowd_channel {
  grant_only
  equity_only
  both
  neither
}

enum org_kind {
  company
  gp
  government_body
  pension_provider
  other
}

enum resolution_method {
  crn_match
  alias_table
  manual_review
}
